{
  "name": "@nexo/monolith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nexo/agent": "workspace:*",
    "@nexo/chat": "workspace:*",
    "@nexo/contracts": "workspace:*",
    "@nexo/identity": "workspace:*",
    "@nexo/knowledge": "workspace:*",
    "@nexo/shared": "workspace:*",
    "@nexo/tickets": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "vitest": "^5.0.5"
  },
  "nexo": {
    "tag": "app"
  }
}
