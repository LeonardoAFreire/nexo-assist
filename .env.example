NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-with-at-least-32-characters
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo
LOG_LEVEL=debug

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_ROUTER_MODEL=deepseek/deepseek-v4-flash-0731
AGENT_CONFIDENCE_THRESHOLD=0.6
LLM_DAILY_BUDGET_USD=2
CHAT_RATE_LIMIT_PER_MINUTE=12

SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=7

TICKETS_OUTAGE_MODE=off
TICKETS_OUTAGE_PROBABILITY=0.1
TICKETS_OUTAGE_DURATION_MS=4000

SEED_DEMO_DATA=true
SEED_USER_PASSWORD=senha@1234
SERVE_WEB_DIR=

VITE_API_URL=http://localhost:3000/api

E2E_DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo_e2e
