{
  "name": "@nexo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./database/testing": {
      "types": "./dist/database/testing/index.d.ts",
      "default": "./dist/database/testing/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./resilience": {
      "types": "./dist/resilience/index.d.ts",
      "default": "./dist/resilience/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.2.0",
    "@nexo/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  },
  "nexo": {
    "tag": "shared"
  }
}
