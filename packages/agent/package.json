{
  "name": "@nexo/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src evals",
    "test": "vitest run --passWithNoTests",
    "eval": "tsc -p tsconfig.evals.json && node dist-evals/evals/run-evals.js",
    "report": "tsc -p tsconfig.evals.json && node dist-evals/evals/report.js"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "@nestjs/common": "^12.2.0",
    "@nexo/contracts": "workspace:*",
    "@nexo/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.154",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/core": "^12.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  },
  "nexo": {
    "tag": "domain:agent"
  }
}
